# ==============================================================================
# KiranaOS — Root Environment Configuration Template
# COPY THIS FILE TO .env OR .env.local AND FILL IN ACTUAL PROJECT CREDENTIALS
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS
# ==============================================================================

# Supabase Cloud Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-scripts-only

# Database Connection (Direct & Connection Pooler)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Application Settings
ENVIRONMENT=development
PORT=3000
DEBUG_LOGGING=true

# Regional & Currency Settings
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
