# Supabase Public Client Credentials (Accessible on Client & Edge)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Server-Only Service Role Key (Used strictly in Server Actions / Route Handlers)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-server-actions-only

# Web App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
